# Backend base URL the app talks to (HTTPS in production).
# In development this is optional: `npm run dev` writes .env.local with your LAN address, and if
# nothing is set the app derives it from the Expo dev server host automatically.
# For EAS builds, set it per environment:  npx eas-cli env:create --name EXPO_PUBLIC_API_URL ...
EXPO_PUBLIC_API_URL=
