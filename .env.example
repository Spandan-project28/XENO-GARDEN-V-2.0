# Root .env.example — each app also has its own .env.example with the full list.
# Backend
MONGO_URI=mongodb://localhost:27017/xeno_garden
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=xg-backend
MQTT_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
# Mobile (build time)
EXPO_PUBLIC_API_URL=http://localhost:4000
