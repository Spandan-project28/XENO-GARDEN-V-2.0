{
  "name": "xeno-garden",
  "private": true,
  "version": "2.0.0",
  "description": "Xeno Garden v2 — smart irrigation: ESP32 + cloud backend + mobile app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "node tools/dev.mjs",
    "test:all": "turbo run test && npm run test:int -w @xeno/backend && npm run test:e2e -w @xeno/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "decode-uri-component": "0.2.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "uuid": "^11.1.1"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "^11.1.1"
  }
}
