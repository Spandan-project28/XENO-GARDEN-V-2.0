{
  "expo": {
    "name": "Xeno Garden",
    "slug": "xeno-garden",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xenogarden",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1210",
    "ios": {
      "bundleIdentifier": "garden.xeno.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Xeno Garden uses Bluetooth to set up your garden device and connect it to WiFi.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "garden.xeno.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1210",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1210",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Xeno Garden uses Bluetooth to set up your garden device and connect it to WiFi."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#34C77B",
          "defaultChannel": "alerts"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Xeno Garden uses your photos so you can add a picture of your plant for health checks.",
          "cameraPermission": "Xeno Garden uses the camera so you can photograph your plant for health checks."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
