{
  "description": "Golden vectors for evaluateAutomation(). Each case = base input with `input` and `settings` overrides applied (shallow merge). Times are ms on one clock. Used by packages/shared (TS) and firmware/test (C++).",
  "base": {
    "now": 1000000,
    "mode": "auto",
    "settings": { "moistureLow": 30, "moistureHigh": 45, "maxPumpRunSec": 600, "cooldownSec": 300, "rainLockout": true },
    "soilMoisture": 50,
    "rain": false,
    "pumpOn": false,
    "pumpSince": 0,
    "cooldownUntil": null,
    "manual": null
  },
  "cases": [
    { "name": "auto: dry soil starts pump", "input": { "soilMoisture": 10 },
      "expected": { "pumpOn": true, "reason": "dry", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "auto: wet soil keeps pump off", "input": { "soilMoisture": 50 },
      "expected": { "pumpOn": false, "reason": "wet", "pumpSince": 0, "cooldownUntil": null, "manual": null } },
    { "name": "auto: wet soil stops running pump", "input": { "soilMoisture": 50, "pumpOn": true, "pumpSince": 900000 },
      "expected": { "pumpOn": false, "reason": "wet", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "auto: hysteresis band holds OFF", "input": { "soilMoisture": 40 },
      "expected": { "pumpOn": false, "reason": "hold", "pumpSince": 0, "cooldownUntil": null, "manual": null } },
    { "name": "auto: hysteresis band holds ON", "input": { "soilMoisture": 40, "pumpOn": true, "pumpSince": 900000 },
      "expected": { "pumpOn": true, "reason": "hold", "pumpSince": 900000, "cooldownUntil": null, "manual": null } },
    { "name": "auto: exactly low threshold is inside band", "input": { "soilMoisture": 30 },
      "expected": { "pumpOn": false, "reason": "hold", "pumpSince": 0, "cooldownUntil": null, "manual": null } },
    { "name": "auto: exactly high threshold is inside band", "input": { "soilMoisture": 45, "pumpOn": true, "pumpSince": 900000 },
      "expected": { "pumpOn": true, "reason": "hold", "pumpSince": 900000, "cooldownUntil": null, "manual": null } },
    { "name": "auto: just below low threshold", "input": { "soilMoisture": 29.9 },
      "expected": { "pumpOn": true, "reason": "dry", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "auto: rain blocks watering", "input": { "soilMoisture": 10, "rain": true },
      "expected": { "pumpOn": false, "reason": "rain", "pumpSince": 0, "cooldownUntil": null, "manual": null } },
    { "name": "auto: rain ignored when lockout disabled", "input": { "soilMoisture": 10, "rain": true }, "settings": { "rainLockout": false },
      "expected": { "pumpOn": true, "reason": "dry", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "auto: rain stops a running pump", "input": { "soilMoisture": 10, "rain": true, "pumpOn": true, "pumpSince": 900000 },
      "expected": { "pumpOn": false, "reason": "rain", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "auto: sensor fault keeps pump off", "input": { "soilMoisture": null },
      "expected": { "pumpOn": false, "reason": "sensor_fault", "pumpSince": 0, "cooldownUntil": null, "manual": null } },
    { "name": "auto: sensor fault stops running pump", "input": { "soilMoisture": null, "pumpOn": true, "pumpSince": 900000 },
      "expected": { "pumpOn": false, "reason": "sensor_fault", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "safety: max runtime reached", "input": { "soilMoisture": 10, "pumpOn": true, "pumpSince": 400000 },
      "expected": { "pumpOn": false, "reason": "max_runtime", "pumpSince": 1000000, "cooldownUntil": 1300000, "manual": null } },
    { "name": "safety: 1ms before max runtime keeps running", "input": { "soilMoisture": 10, "pumpOn": true, "pumpSince": 400001 },
      "expected": { "pumpOn": true, "reason": "dry", "pumpSince": 400001, "cooldownUntil": null, "manual": null } },
    { "name": "safety: cooldown blocks dry soil", "input": { "soilMoisture": 10, "cooldownUntil": 1100000 },
      "expected": { "pumpOn": false, "reason": "cooldown", "pumpSince": 0, "cooldownUntil": 1100000, "manual": null } },
    { "name": "safety: cooldown ends exactly at now", "input": { "soilMoisture": 10, "cooldownUntil": 1000000 },
      "expected": { "pumpOn": true, "reason": "dry", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "manual mode: idle without command", "input": { "mode": "manual", "soilMoisture": 10 },
      "expected": { "pumpOn": false, "reason": "idle", "pumpSince": 0, "cooldownUntil": null, "manual": null } },
    { "name": "manual mode: switching to manual stops pump", "input": { "mode": "manual", "soilMoisture": 10, "pumpOn": true, "pumpSince": 900000 },
      "expected": { "pumpOn": false, "reason": "idle", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "manual ON overrides auto wet soil", "input": { "soilMoisture": 60, "manual": { "cmdId": "c1", "pump": "ON", "expiresAt": 1600000 } },
      "expected": { "pumpOn": true, "reason": "manual", "pumpSince": 1000000, "cooldownUntil": null, "manual": { "cmdId": "c1", "pump": "ON", "expiresAt": 1600000 } } },
    { "name": "manual ON in manual mode", "input": { "mode": "manual", "manual": { "cmdId": "c2", "pump": "ON", "expiresAt": 1600000 } },
      "expected": { "pumpOn": true, "reason": "manual", "pumpSince": 1000000, "cooldownUntil": null, "manual": { "cmdId": "c2", "pump": "ON", "expiresAt": 1600000 } } },
    { "name": "manual ON expired exactly at now (manual mode)", "input": { "mode": "manual", "pumpOn": true, "pumpSince": 700000, "manual": { "cmdId": "c3", "pump": "ON", "expiresAt": 1000000 } },
      "expected": { "pumpOn": false, "reason": "idle", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "manual OFF pauses automation", "input": { "soilMoisture": 10, "manual": { "cmdId": "c4", "pump": "OFF", "expiresAt": 1600000 } },
      "expected": { "pumpOn": false, "reason": "manual_off", "pumpSince": 0, "cooldownUntil": null, "manual": { "cmdId": "c4", "pump": "OFF", "expiresAt": 1600000 } } },
    { "name": "manual ON overrides rain", "input": { "rain": true, "manual": { "cmdId": "c5", "pump": "ON", "expiresAt": 1600000 } },
      "expected": { "pumpOn": true, "reason": "manual", "pumpSince": 1000000, "cooldownUntil": null, "manual": { "cmdId": "c5", "pump": "ON", "expiresAt": 1600000 } } },
    { "name": "manual ON works with sensor fault", "input": { "soilMoisture": null, "manual": { "cmdId": "c6", "pump": "ON", "expiresAt": 1600000 } },
      "expected": { "pumpOn": true, "reason": "manual", "pumpSince": 1000000, "cooldownUntil": null, "manual": { "cmdId": "c6", "pump": "ON", "expiresAt": 1600000 } } },
    { "name": "manual ON refused during cooldown and cancelled", "input": { "cooldownUntil": 1200000, "manual": { "cmdId": "c7", "pump": "ON", "expiresAt": 1600000 } },
      "expected": { "pumpOn": false, "reason": "cooldown", "pumpSince": 0, "cooldownUntil": 1200000, "manual": null } },
    { "name": "manual ON is cut by max runtime", "input": { "pumpOn": true, "pumpSince": 400000, "manual": { "cmdId": "c8", "pump": "ON", "expiresAt": 1600000 } },
      "expected": { "pumpOn": false, "reason": "max_runtime", "pumpSince": 1000000, "cooldownUntil": 1300000, "manual": null } },
    { "name": "manual ON expired hands back to auto (wet)", "input": { "soilMoisture": 60, "pumpOn": true, "pumpSince": 900000, "manual": { "cmdId": "c9", "pump": "ON", "expiresAt": 999999 } },
      "expected": { "pumpOn": false, "reason": "wet", "pumpSince": 1000000, "cooldownUntil": null, "manual": null } },
    { "name": "manual ON expired hands back to auto (hold keeps running)", "input": { "soilMoisture": 40, "pumpOn": true, "pumpSince": 900000, "manual": { "cmdId": "c10", "pump": "ON", "expiresAt": 999999 } },
      "expected": { "pumpOn": true, "reason": "hold", "pumpSince": 900000, "cooldownUntil": null, "manual": null } },
    { "name": "manual mode beats rain and sensor fault", "input": { "mode": "manual", "rain": true, "soilMoisture": null },
      "expected": { "pumpOn": false, "reason": "idle", "pumpSince": 0, "cooldownUntil": null, "manual": null } },
    { "name": "sensor fault reported before rain", "input": { "rain": true, "soilMoisture": null },
      "expected": { "pumpOn": false, "reason": "sensor_fault", "pumpSince": 0, "cooldownUntil": null, "manual": null } },
    { "name": "rain reported before cooldown", "input": { "rain": true, "soilMoisture": 10, "cooldownUntil": 1100000 },
      "expected": { "pumpOn": false, "reason": "rain", "pumpSince": 0, "cooldownUntil": 1100000, "manual": null } },
    { "name": "manual OFF while pump running stops it", "input": { "soilMoisture": 10, "pumpOn": true, "pumpSince": 900000, "manual": { "cmdId": "c11", "pump": "OFF", "expiresAt": 1600000 } },
      "expected": { "pumpOn": false, "reason": "manual_off", "pumpSince": 1000000, "cooldownUntil": null, "manual": { "cmdId": "c11", "pump": "OFF", "expiresAt": 1600000 } } }
  ]
}
